---
import type { Sector } from '../../data/sectors';
import { mainNavigation } from '../../config/navigation';
interface Props { sector: Sector }
const { sector } = Astro.props;
const links = mainNavigation[0].children?.filter(item => sector.services.some(slug => item.href.endsWith(`/${slug}`))) || [];
---
<section class="space-y-6">
  <h2 class="text-2xl font-bold text-navy-900">Hangi ihtiyaçları ele alıyoruz?</h2>
  <p class="text-slate-600">{sector.audience}</p>
  <div class="grid gap-5 md:grid-cols-3">
    {sector.needs.map(need => <article class="rounded-2xl border border-slate-200 bg-white p-6">
      <h3 class="text-lg font-bold text-navy-900">{need.title}</h3>
      <p class="mt-3 text-sm text-slate-600">{need.problem}</p>
      <p class="mt-3 text-sm leading-relaxed text-slate-700">{need.approach}</p>
    </article>)}
  </div>
</section>
<section class="grid gap-6 md:grid-cols-2">
  <div class="rounded-2xl bg-slate-50 p-6">
    <h2 class="text-xl font-bold text-navy-900">Çalışmanın somut çıktıları</h2>
    <ul class="mt-4 list-disc space-y-3 pl-5 text-sm text-slate-700">{sector.deliverables.map(item => <li>{item}</li>)}</ul>
  </div>
  <div class="rounded-2xl border border-slate-200 p-6">
    <h2 class="text-xl font-bold text-navy-900">Ayrıca kapsamlandırılan işler</h2>
    <ul class="mt-4 list-disc space-y-3 pl-5 text-sm text-slate-700">{sector.exclusions.map(item => <li>{item}</li>)}</ul>
    <p class="mt-4 text-sm text-slate-600">Donanım, lisans, üçüncü taraf abonelikleri ve kapsam dışı projeler ayrıca değerlendirilir.</p>
  </div>
</section>
<section class="space-y-4">
  <h2 class="text-2xl font-bold text-navy-900">Sık sorulan sorular</h2>
  {sector.questions.map(item => <details class="rounded-xl border border-slate-200 p-5">
    <summary class="cursor-pointer font-semibold text-navy-900">{item.q}</summary>
    <p class="mt-3 text-sm leading-relaxed text-slate-600">{item.a}</p>
  </details>)}
</section>
<section class="rounded-2xl border border-brandBlue-200 bg-brandBlue-50 p-6 sm:p-8">
  <p class="text-xs font-bold uppercase tracking-wide text-brandBlue-700">Örnek çözüm senaryosu · gerçek müşteri vakası değildir</p>
  <h2 class="mt-3 text-xl font-bold text-navy-900">{sector.scenario.title}</h2>
  <p class="mt-3 text-sm text-slate-700">{sector.scenario.problem}</p>
  <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm text-slate-700">{sector.scenario.steps.map(step => <li>{step}</li>)}</ol>
  <p class="mt-4 text-sm text-slate-700"><strong>Sonuç nasıl takip edilir?</strong> {sector.scenario.measurement}</p>
</section>
<section>
  <h2 class="text-xl font-bold text-navy-900">İlgili hizmet kapsamları</h2>
  <ul class="mt-4 flex flex-wrap gap-3">{links.map(item => <li><a class="inline-block rounded-lg border border-slate-200 px-4 py-3 text-sm font-semibold text-brandBlue-700 hover:bg-slate-50" href={item.href}>{item.label} →</a></li>)}</ul>
</section>
