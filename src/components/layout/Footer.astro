---
import { siteConfig } from '../../config/site';
import { footerNavigation } from '../../config/navigation';

const currentYear = new Date().getFullYear();
---

<footer class="bg-navy-950 text-slate-400 pt-16 pb-12 border-t border-navy-900" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Alt Bilgi (Footer)</h2>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-navy-800">
      
      <!-- Bölüm 1: Marka ve Tanım -->
      <div class="space-y-4">
        <a href="/" class="inline-block focus-visible:outline-white" aria-label="BT Masası">
          <img
            src="/brand/logo.png"
            alt="BT Masası"
            class="h-10 sm:h-12 w-auto brightness-0 invert opacity-95"
            width="240"
            height="48"
            loading="lazy"
          />
        </a>
        <p class="text-sm text-slate-300 leading-relaxed">
          BT Masası, işletmelerin bilgisayar, kullanıcı, ağ, bulut, yedekleme ve güvenlik süreçlerini düzenli olarak yönetmesine yardımcı olan dış kaynak bilgi teknolojileri hizmetidir.
        </p>
        <p class="text-xs text-brandTeal-400 font-medium">
          Aksaray'da yerinde · Türkiye genelinde uzaktan hizmet.
        </p>
      </div>

      <!-- Bölüm 2: Hizmetler -->
      <div>
        <h3 class="text-sm font-semibold text-white tracking-wider uppercase mb-4">Hizmetlerimiz</h3>
        <ul class="space-y-2.5 text-sm">
          {
            footerNavigation.services.map((item) => (
              <li>
                <a href={item.href} class="hover:text-white transition-colors">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Bölüm 3: Kurumsal & Yasal -->
      <div>
        <h3 class="text-sm font-semibold text-white tracking-wider uppercase mb-4">Kurumsal & Yasal</h3>
        <ul class="space-y-2.5 text-sm">
          {
            footerNavigation.company.map((item) => (
              <li>
                <a href={item.href} class="hover:text-white transition-colors">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="mt-4 pt-3 border-t border-navy-800 space-y-2 text-xs">
          {
            footerNavigation.legal.map((item) => (
              <div>
                <a href={item.href} class="text-slate-400 hover:text-slate-200 transition-colors">
                  {item.label}
                </a>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Bölüm 4: İletişim ve Hizmet Bölgesi -->
      <div class="space-y-4 text-sm">
        <h3 class="text-sm font-semibold text-white tracking-wider uppercase">Hizmet Bölgesi & İletişim</h3>
        
        <div>
          <span class="text-xs font-semibold text-slate-300 uppercase block">Yerinde Destek:</span>
          <p class="text-slate-300 text-sm mt-0.5">Aksaray Merkez, Aksaray OSB</p>
        </div>

        <div>
          <span class="text-xs font-semibold text-slate-300 uppercase block">Uzaktan Destek:</span>
          <p class="text-slate-300 text-sm mt-0.5">{siteConfig.remoteServiceArea}</p>
        </div>

        <div>
          <span class="text-xs font-semibold text-slate-300 uppercase block">Çalışma Saatleri:</span>
          <p class="text-slate-300 text-sm mt-0.5">{siteConfig.businessHours}</p>
        </div>

        {siteConfig.email && (
          <div>
            <span class="text-xs font-semibold text-slate-300 uppercase block">E-posta:</span>
            <a href={`mailto:${siteConfig.email}`} class="text-brandBlue-300 hover:underline">
              {siteConfig.email}
            </a>
          </div>
        )}

        {siteConfig.phoneDisplay && (
          <div>
            <span class="text-xs font-semibold text-slate-300 uppercase block">Telefon:</span>
            <a href={`tel:${siteConfig.phoneE164}`} class="text-brandBlue-300 hover:underline">
              {siteConfig.phoneDisplay}
            </a>
          </div>
        )}

        {(siteConfig.socialLinks.linkedin || siteConfig.socialLinks.instagram) && (
          <div>
            <span class="text-xs font-semibold text-slate-300 uppercase block">Sosyal Ağlar:</span>
            <div class="flex items-center gap-3.5 mt-1.5 flex-wrap">
              {siteConfig.socialLinks.linkedin && (
                <a
                  href={siteConfig.socialLinks.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs text-brandBlue-300 hover:text-white transition-colors"
                  aria-label="BT Masası LinkedIn Sayfası"
                >
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                    <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.64a1.64 1.64 0 1 0 0 3.28 1.64 1.64 0 0 0 0-3.28Z"/>
                  </svg>
                  <span>LinkedIn</span>
                </a>
              )}
              {siteConfig.socialLinks.instagram && (
                <a
                  href={siteConfig.socialLinks.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs text-pink-400 hover:text-pink-300 transition-colors"
                  aria-label="BT Masası Instagram Hesabı"
                >
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069M12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
                  </svg>
                  <span>Instagram</span>
                </a>
              )}
            </div>
          </div>
        )}

        <div class="pt-2">
          <a
            href="/ucretsiz-bt-kontrolu"
            class="inline-block text-xs font-semibold px-3 py-2 bg-navy-800 hover:bg-navy-700 text-slate-200 rounded-lg transition-colors border border-navy-700"
          >
            Ücretsiz BT Kontrolü İsteyin →
          </a>
        </div>
      </div>

    </div>

    <!-- Alt Telif & Yasal Not -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>
        © {currentYear} {siteConfig.legalCompanyName || siteConfig.brandName}. Tüm hakları saklıdır.
      </p>
      <p class="text-center md:text-right">
        Bilgisayar Mühendisi Bekir Duran tarafından yönetilmektedir.
      </p>
    </div>
  </div>
</footer>
