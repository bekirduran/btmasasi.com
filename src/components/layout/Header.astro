---
import { Image } from 'astro:assets';
import logo from '../../assets/logo.png';
import { siteConfig } from '../../config/site';
import { mainNavigation } from '../../config/navigation';
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200 transition-shadow">
  <div class="bg-navy-950 text-white border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-3 min-h-14 py-1.5">
      <div class="flex items-center gap-2 text-xs sm:text-sm">
        <svg class="hidden sm:block w-4 h-4 text-brandTeal-400 shrink-0" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 13v-1a8 8 0 0 1 16 0v1M4 12H3v7h4v-7H4Zm16 0h1v7h-4v-7h3Zm0 7a3 3 0 0 1-3 3h-3" />
        </svg>
        <span class="font-medium text-slate-200">Destek Merkezi</span>
        <span class="hidden md:inline text-slate-400">/</span>
        <span class="hidden md:inline text-slate-300">Teknik bir sorun mu yaşıyorsunuz?</span>
      </div>
      <a
        href={siteConfig.supportUrl}
        class="group inline-flex shrink-0 items-center justify-center gap-2 min-h-11 px-3 sm:px-4 rounded-lg bg-brandTeal-400 text-navy-950 text-xs sm:text-sm font-semibold hover:bg-brandTeal-100 transition-colors focus-visible:outline-white"
      >
        Arıza Kaydı Oluştur
        <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M7 7h10v10" />
        </svg>
      </a>
    </div>
  </div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Marka Logosu -->
      <a href="/" class="flex items-center gap-3 focus-visible:outline-brandBlue-600 rounded-lg p-1" aria-label="BT Masası Ana Sayfa">
        <Image
          src={logo}
          alt="BT Masası — Bilgi Teknolojileri ve Danışmanlık"
          class="h-10 sm:h-12 w-auto object-contain"
          width={250}
          widths={[250, 500, 750]}
          sizes="(min-width: 640px) 250px, 209px"
          format="webp"
          quality={85}
          height={48}
          loading="eager"
          fetchpriority="high"
        />
      </a>

      <!-- Masaüstü Navigasyon -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2" aria-label="Ana Menü">
        {
          mainNavigation.map((item) => (
            item.children ? (
              <div class="relative group">
                <button
                  type="button"
                  class="flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-slate-700 hover:text-brandBlue-600 rounded-md transition-colors focus-visible:outline-brandBlue-600"
                  aria-haspopup="true"
                  aria-expanded="false"
                  id="services-menu-button"
                >
                  <span>{item.label}</span>
                  <svg class="w-4 h-4 text-slate-400 group-hover:text-brandBlue-600 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>

                <!-- Dropdown Menü -->
                <div
                  class="absolute left-0 mt-1 w-80 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 bg-white border border-slate-200 rounded-xl shadow-lg p-2 z-50"
                  role="menu"
                  aria-labelledby="services-menu-button"
                >
                  <div class="px-3 py-2 text-xs font-semibold uppercase tracking-wider text-slate-400 border-b border-slate-100 mb-1">
                    BT Masası Hizmetleri
                  </div>
                  {item.children.map((sub) => (
                    <a
                      href={sub.href}
                      class="block px-3 py-2 rounded-lg hover:bg-slate-50 transition-colors focus-visible:bg-slate-50"
                      role="menuitem"
                    >
                      <div class="text-sm font-medium text-navy-900">{sub.label}</div>
                      {sub.description && (
                        <div class="text-xs text-slate-500 mt-0.5 leading-snug">{sub.description}</div>
                      )}
                    </a>
                  ))}
                  <div class="mt-1 pt-2 border-t border-slate-100">
                    <a href="/hizmetler" class="block px-3 py-1.5 text-xs font-semibold text-brandBlue-600 hover:underline">
                      Tüm Hizmetleri İncele →
                    </a>
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={item.href}
                class="px-3 py-2 text-sm font-medium text-slate-700 hover:text-brandBlue-600 rounded-md transition-colors"
              >
                {item.label}
              </a>
            )
          ))
        }
      </nav>

      <!-- Sağ Eylem Alanı (CTA) -->
      <div class="hidden lg:flex items-center gap-4">
        {siteConfig.phoneDisplay && (
          <a
            href={`tel:${siteConfig.phoneE164}`}
            class="text-sm font-medium text-slate-600 hover:text-brandBlue-600 flex items-center gap-1.5"
          >
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>{siteConfig.phoneDisplay}</span>
          </a>
        )}

        <a
          href="/ucretsiz-bt-kontrolu"
          class="inline-flex items-center justify-center px-4 py-2.5 text-sm font-semibold text-white bg-brandBlue-600 hover:bg-brandBlue-700 rounded-xl shadow-sm hover:shadow transition-all focus-visible:outline-brandBlue-600"
        >
          Teklif Al
        </a>
      </div>

      <!-- Mobil Menü Butonu -->
      <div class="flex lg:hidden">
        <button
          type="button"
          id="mobile-menu-toggle"
          class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl border border-slate-200 bg-white p-2 text-slate-600 shadow-sm transition-colors hover:border-brandBlue-200 hover:bg-brandBlue-50 hover:text-navy-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brandBlue-600"
          aria-label="Mobil menüyü aç"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg id="menu-icon-open" class="w-6 h-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <div id="mobile-menu-backdrop" class="fixed inset-0 z-40 hidden bg-navy-950/35 backdrop-blur-[2px] lg:hidden" aria-hidden="true"></div>

  <!-- Mobil Açılır Menü -->
  <div
    id="mobile-menu"
    class="absolute inset-x-0 top-full z-50 hidden max-h-[calc(100dvh-7rem)] overflow-y-auto overscroll-contain border-b border-slate-200 bg-white shadow-2xl lg:hidden"
    aria-label="Mobil menü"
    role="dialog"
    aria-modal="true"
    aria-labelledby="mobile-menu-title"
  >
    <nav class="mx-auto max-w-2xl space-y-5 px-4 pb-8 pt-4 sm:px-6" aria-label="Mobil ana menü">
      <div class="flex items-center justify-between border-b border-slate-100 px-1 pb-3">
        <div>
          <p id="mobile-menu-title" class="text-xs font-bold uppercase tracking-[0.16em] text-brandBlue-600">BT Masası</p>
          <p class="mt-1 text-sm text-slate-500">İhtiyacınız olan bilgiye ulaşın</p>
        </div>
        <span class="rounded-full bg-brandTeal-50 px-3 py-1 text-xs font-semibold text-brandTeal-700">Mobil menü</span>
      </div>

      <div class="space-y-1">
      {
        mainNavigation.map((item) => (
          item.children ? (
            <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-2">
              <a
                href={item.href}
                data-mobile-menu-link
                class="flex min-h-11 items-center justify-between rounded-xl px-3 py-2 text-base font-bold text-navy-900 transition-colors hover:bg-white hover:text-brandBlue-700"
              >
                {item.label}
                <span aria-hidden="true" class="text-lg leading-none text-brandBlue-600">→</span>
              </a>
              <div class="ml-3 space-y-1 border-l-2 border-brandBlue-100 pl-3">
                {item.children.map((sub) => (
                  <a
                    href={sub.href}
                    data-mobile-menu-link
                    class="block min-h-10 rounded-lg px-3 py-2 text-sm leading-snug text-slate-600 transition-colors hover:bg-white hover:text-brandBlue-700"
                  >
                    <span class="font-medium">{sub.label}</span>
                    {sub.description && <span class="mt-0.5 block text-xs leading-snug text-slate-400">{sub.description}</span>}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              data-mobile-menu-link
              class="flex min-h-11 items-center justify-between rounded-xl px-3 py-2 text-base font-semibold text-slate-700 transition-colors hover:bg-brandBlue-50 hover:text-brandBlue-700"
            >
              {item.label}
              <span aria-hidden="true" class="text-lg leading-none text-slate-300 transition-colors">→</span>
            </a>
          )
        ))
      }
      </div>

    <div class="flex flex-col gap-2 border-t border-slate-100 pt-5">
      {siteConfig.phoneDisplay && (
        <a
          href={`tel:${siteConfig.phoneE164}`}
          data-mobile-menu-link
          class="flex min-h-11 w-full items-center justify-center gap-2 rounded-xl bg-slate-100 px-4 py-2.5 text-sm font-semibold text-navy-900 transition-colors hover:bg-slate-200"
        >
          <svg class="w-4 h-4 text-brandBlue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>{siteConfig.phoneDisplay}</span>
        </a>
      )}
      <a
        href="/ucretsiz-bt-kontrolu"
        data-mobile-menu-link
        class="w-full rounded-xl bg-brandBlue-600 px-4 py-3 text-center text-sm font-semibold text-white transition-colors hover:bg-brandBlue-700"
      >
        Ücretsiz BT Ön Değerlendirmesi
      </a>
      <a
        href="/iletisim"
        data-mobile-menu-link
        class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-center text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50"
      >
        İletişime Geçin
      </a>
    </div>
    </div>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileMenuBackdrop = document.getElementById('mobile-menu-backdrop');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');

  if (toggleBtn && mobileMenu && mobileMenuBackdrop && openIcon && closeIcon) {
    const menuLinks = mobileMenu.querySelectorAll('[data-mobile-menu-link]');

    const setMenuState = (isOpen: boolean) => {
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
      toggleBtn.setAttribute('aria-label', isOpen ? 'Mobil menüyü kapat' : 'Mobil menüyü aç');
      mobileMenu.classList.toggle('hidden', !isOpen);
      mobileMenuBackdrop.classList.toggle('hidden', !isOpen);
      openIcon.classList.toggle('hidden', isOpen);
      closeIcon.classList.toggle('hidden', !isOpen);
      document.body.classList.toggle('overflow-hidden', isOpen);
    };

    toggleBtn.addEventListener('click', () => {
      setMenuState(toggleBtn.getAttribute('aria-expanded') !== 'true');
    });

    mobileMenuBackdrop.addEventListener('click', () => setMenuState(false));
    menuLinks.forEach(link => link.addEventListener('click', () => setMenuState(false)));

    // ESC tuşuyla mobil menüyü kapatma
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
        setMenuState(false);
        toggleBtn.focus();
      }
    });

    window.matchMedia('(min-width: 1024px)').addEventListener('change', event => {
      if (event.matches) setMenuState(false);
    });
  }
</script>
