---
export interface Props {
  question: string;
  id?: string;
  open?: boolean;
}

const { question, id, open = false } = Astro.props;
---

<details
  class="group border border-slate-200 rounded-xl overflow-hidden bg-white transition-colors"
  id={id}
  open={open}
>
  <summary class="flex items-center justify-between p-5 text-left font-semibold text-navy-900 cursor-pointer hover:bg-slate-50 list-none focus-visible:outline-brandBlue-600 select-none">
    <span class="text-base sm:text-lg">{question}</span>
    <span class="ml-4 flex-shrink-0 text-slate-400 group-hover:text-brandBlue-600 transition-transform group-open:rotate-180">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </span>
  </summary>
  <div class="px-5 pb-5 pt-1 text-slate-600 text-sm sm:text-base leading-relaxed border-t border-slate-100">
    <slot />
  </div>
</details>
