---
export interface Props {
  class?: string;
  hover?: boolean;
}

const { class: className = '', hover = true } = Astro.props;
---

<div
  class={`bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 transition-all duration-200 ${
    hover ? 'hover:border-slate-300 hover:shadow-md' : 'shadow-sm'
  } ${className}`}
>
  <slot />
</div>
