---
import { createPageGraph } from '../../lib/seo/schema';
export interface Props {
  title?: string;
  canonical?: string;
  schemaType?: 'Organization' | 'WebSite' | 'Service' | 'Article' | 'FAQPage' | 'BreadcrumbList';
  customSchema?: Record<string, unknown> | Array<Record<string, unknown>>;
}
const { title = 'BT Masası', canonical, customSchema } = Astro.props;
const graph = createPageGraph(canonical || Astro.url.pathname, title, customSchema);
const json = JSON.stringify(graph).replace(/</g, '\\u003c');
---
<script type="application/ld+json" set:html={json} />
