---
import { siteConfig } from '../../config/site';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description = "BT Masası, Aksaray'daki işletmelere kurumsal IT destek, network, sunucu, Microsoft 365, yedekleme ve yönetilen BT hizmetleri sunar.",
  canonical,
  ogImage = "/og-default.png",
  ogType = "website",
  publishedTime,
  modifiedTime,
} = Astro.props;

// Title formatı
const siteTitle = title ? `${title} | ${siteConfig.brandName}` : `${siteConfig.brandName} | Aksaray Kurumsal IT Destek ve Yönetilen BT Hizmetleri`;

// Canonical URL (mutlak ve trailing slash'sız)
const canonicalUrl = canonical || new URL(Astro.url.pathname.replace(/\/$/, ''), siteConfig.domain).href;
const fullOgImageUrl = new URL(ogImage, siteConfig.domain).href;
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  
  <title>{siteTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  
  <!-- Favicon ve App Simgeleri -->
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  
  <!-- Open Graph / Facebook / LinkedIn -->
  <meta property="og:site_name" content={siteConfig.brandName} />
  <meta property="og:title" content={siteTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content="tr_TR" />
  <meta property="og:image" content={fullOgImageUrl} />
  <meta property="og:image:alt" content={siteConfig.brandName} />

  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={siteTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullOgImageUrl} />

  <!-- RSS Feed -->
  <link rel="alternate" type="application/rss+xml" title="BT Masası — İşletmeler İçin BT Rehberi" href="/rss.xml" />

  <slot />
</head>
