---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';

type PackageDetail = {
  slug: string;
  title: string;
  description: string;
  purpose: string;
  image?: string;
  details: string[];
};

const packages: PackageDetail[] = [
  {
    slug: 'bakim', title: 'Bakım Paketi', description: 'Teknik Destek, Bakım ve Onarım', image: '/packages/bakim-paketi.png',
    purpose: 'Günlük teknik sorunları çözmek ve çalışanların işlerine devam etmesini sağlamak.',
    details: ['Bilgisayarların donanım ve yazılım arızalarının tespiti, bakım ve kurulum işlemleri', 'Bilgisayar parça değişimi ve yükseltmeleri', 'Yazıcı kurulumu, bağlantı ve yazılım sorunlarının giderilmesi', 'Küçük ölçekli ağ kablolaması, uçlandırma ve bağlantı kablo / kanal düzenlemeleri', 'Kamera sistemlerinde basit bağlantı ve yapılandırma sorunlarına destek', 'Uzaktan ve kararlaştırılan kapsamda yerinde müdahale'],
  },
  {
    slug: 'bt', title: 'BT Paketi', description: 'Kurumsal E-posta Hesap ve Cihaz Yönetimi', image: '/packages/bt-paketi.png',
    purpose: 'Kurumsal hesapların, cihazların ve erişim yetkilerinin düzenli ve şirket kontrolünde tutulması.',
    details: ['Kurumsal e-posta hesaplarının ve ortak posta kutularının yönetimi', 'E-posta güvenlik ayarları ve desteklenen sistemlerde çok faktörlü kimlik doğrulama', 'Erişimlerin görev ihtiyaçlarına göre incelenmesi ve işletme onayıyla gereksiz yetkilerin kaldırılması', 'İnternet alan adları, DNS kayıtları ve yenileme tarihlerinin takibi', 'Personelin işe giriş, görev değişikliği ve işten ayrılışında hesap, erişim ve cihaz işlemleri', 'Yerel hesaplar, Active Directory ve bulut hizmetlerindeki kullanıcı hesaplarının yönetimi', 'Ortak klasörler ve kurumsal uygulamalar için erişim yetkilerinin düzenlenmesi', 'Cihaz envanteri, zimmet kayıtları ve lisans bilgilerinin takibi', 'Devredilen veya kullanım dışı kalan cihazlarda onaylı veri koruma ve silme işlemleri'],
  },
  { slug: 'guvenlik', title: 'Güvenlik Paketi', description: 'Siber Güvenlik, Çalışan Eğitimi ve Uyum Hazırlığı', image: '/packages/guvenlik-paketi.png', purpose: 'Güvenlik eksiklerini görünür kılmak, çalışan farkındalığını geliştirmek ve olaylara hazırlığı güçlendirmek.', details: ['Mevcut güvenlik durumunun değerlendirilmesi ve öncelikli iyileştirme planı', 'Çalışan farkındalık eğitimleri ve kullanım kuralları', 'Antivirüs, uç nokta ve temel cihaz güvenliği kontrolleri', 'KVKK ve ISO 27001 hazırlığına teknik uygulama ve dokümantasyon desteği'] },
  { slug: 'sunucu', title: 'Sunucu Paketi', description: 'Sunucu Ağ ve Yedekleme Yönetimi', image: '/packages/sunucu-paketi.png', purpose: 'Teknik altyapının düzenli işletilmesi, bağlantıların kontrollü yönetilmesi ve veri kurtarma hazırlığının sağlanması.', details: ['Sunucu, ağ cihazları, VPN ve güvenlik duvarı yönetimi', 'Kurumsal ve misafir ağlarının uygun altyapıda ayrılması', 'Yedekleme düzeninin oluşturulması, kontrolü ve iyileştirilmesi', 'Kontrollü geri yükleme testleri ve kurtarma dokümantasyonu'] },
  { slug: 'web', title: 'Web Paketi', description: 'Web Sitesi Yönetimi ve Geliştirme', image: '/packages/web-paketi.png', purpose: 'Web sitesinin güncel, kullanılabilir ve işletmenin faaliyetlerini doğru yansıtır halde tutulması.', details: ['Site bakım ve teknik kontrolleri', 'Yazılım ve bileşen güncellemeleri ile yedekleme', 'İçerik, görsel, hizmet ve referans bilgilerinin güncellenmesi', 'Performans, temel erişilebilirlik, SEO ve GEO iyileştirmeleri', 'Form ve temel site işlevlerinin kontrolü'] },
  { slug: 'medya', title: 'Medya Paketi', description: 'Sosyal Medya ve Görsel İçerik Yönetimi', image: '/packages/medya-paketi.png', purpose: 'İşletmenin hizmetlerini, projelerini ve uzmanlığını düzenli içeriklerle anlatmak.', details: ['Google İşletme Profili, Instagram, LinkedIn ve YouTube hesaplarının yönetimi', 'İçerik takvimi, paylaşım metinleri ve görsel içeriklerin hazırlanması', 'Onay sonrası yayınlama ve profil bilgilerinin güncellenmesi', 'Fotoğraf, uygun koşullarda drone çekimi ve video kurgu', 'İçerik performansının raporlanması'] },
  { slug: 'bt-yonetimi-guvenlik', title: 'BT Yönetimi ve Güvenlik', description: 'BT + Sunucu + Güvenlik', purpose: 'Kesintisiz operasyon, güçlü altyapı ve güvenli gelecek için üç temel paketi birleştirmek.', details: ['BT Paketi: Kurumsal E-posta, Hesap ve Cihaz Yönetimi', 'Sunucu Paketi: Sunucu, Ağ ve Yedekleme Yönetimi', 'Güvenlik Paketi: Siber Güvenlik, Çalışan Eğitimi ve Uyum Hazırlığı'] },
  { slug: 'kurumsal', title: 'Kurumsal Paket', description: 'BT + Sunucu + Güvenlik + Bakım', purpose: 'Güçlü altyapı, güvenli sistemler ve kesintisiz iş süreçlerini tek kapsamda birleştirmek.', details: ['BT Paketi, Sunucu Paketi ve Güvenlik Paketi', 'Bakım Paketi: Teknik Destek, Bakım ve Onarım', 'Tek çatı altında koordineli hizmet akışı'] },
  { slug: 'kurumsal-360', title: 'Kurumsal 360', description: 'Altı hizmet paketi, tek kurumsal ekosistem', purpose: 'BT, güvenlik, altyapı, web ve medya yönetimini tek muhatap ve tek sözleşmeyle birleştirmek.', details: ['BT, Sunucu, Güvenlik ve Bakım paketleri', 'Web Paketi: Web Sitesi Yönetimi ve Geliştirme', 'Medya Paketi: Sosyal Medya ve Görsel İçerik Yönetimi', 'Tüm teknoloji alanlarında tek koordinasyon noktası'] },
];

export function getStaticPaths() {
  return ['bakim', 'bt', 'guvenlik', 'sunucu', 'web', 'medya', 'bt-yonetimi-guvenlik', 'kurumsal', 'kurumsal-360'].map(slug => ({ params: { slug } }));
}

const pkg = packages.find(item => item.slug === Astro.params.slug)!;
const canonical = `https://btmasasi.com/paketler/${pkg.slug}`;
---

<BaseLayout title={pkg.title} description={`${pkg.description}. ${pkg.purpose}`} canonical={canonical}>
  <div class="bg-slate-50 border-b border-slate-200 py-10 sm:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[{ label: 'Paketler', href: '/paketler' }, { label: pkg.title }]} />
      <div class="mt-5 max-w-3xl"><h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-navy-900">{pkg.title}</h1><p class="mt-3 text-lg sm:text-xl font-semibold text-brandBlue-700">{pkg.description}</p></div>
    </div>
  </div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(320px,.9fr)] lg:items-start">
      <div>
        {pkg.image ? <img src={pkg.image} alt={`${pkg.title} - ${pkg.description}`} width={pkg.slug === 'web' ? 1086 : 1122} height={pkg.slug === 'web' ? 1448 : 1402} loading="eager" decoding="async" class="w-full rounded-2xl border border-slate-200 shadow-lg" /> : <div class="rounded-2xl border border-slate-200 bg-gradient-to-br from-brandBlue-50 to-slate-50 p-10"><p class="text-sm font-semibold uppercase tracking-wide text-brandBlue-700">BT Masası hizmet paketi</p><h2 class="mt-4 text-3xl font-extrabold text-navy-900">{pkg.title}</h2><p class="mt-3 text-lg text-slate-600">{pkg.description}</p></div>}
      </div>
      <div class="space-y-8">
        <section class="rounded-2xl border border-brandTeal-200 bg-brandTeal-50/50 p-6 sm:p-8"><h2 class="text-xl font-bold text-navy-900">Amaç</h2><p class="mt-3 text-lg leading-relaxed text-slate-700">{pkg.purpose}</p></section>
        <section class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8"><h2 class="text-xl font-bold text-navy-900">Paket içeriği</h2><ul class="mt-5 space-y-3 text-sm leading-relaxed text-slate-700">{pkg.details.map(item => <li class="flex items-start gap-3"><span class="mt-1.5 h-2 w-2 flex-none rounded-full bg-brandBlue-600"></span><span>{item}</span></li>)}</ul></section>
        <Button href="/iletisim" variant="primary" class="w-full">Kapsam ve fiyatlandırma için iletişime geçin</Button>
      </div>
    </div>
  </div>
</BaseLayout>
