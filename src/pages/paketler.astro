  { name: 'Kurumsal Paket', subtitle: 'BT + Sunucu + Güvenlik + Bakım', description: 'Güçlü altyapı, güvenli sistemler ve kesintisiz iş süreçleri için dört paketi tek kapsamda birleştirir.', highlights: ['Operasyon, altyapı ve güvenlik tek kapsamda', 'Donanım ve günlük destek odağı', 'Dengeli kurumsal çözüm'], details: ['BT Paketi: Kurumsal E-posta, Hesap ve Cihaz Yönetimi', 'Sunucu Paketi: Sunucu, Ağ ve Yedekleme Yönetimi', 'Güvenlik Paketi: Siber Güvenlik, Çalışan Eğitimi ve Uyum Hazırlığı', 'Bakım Paketi: Teknik Destek, Bakım ve Onarım', 'Tek çatı altında koordineli hizmet akışı'], tone: 'green' },
  { name: 'Kurumsal 360', subtitle: 'Altı hizmet paketi, tek kurumsal ekosistem', description: 'BT, güvenlik, altyapı, web ve medya yönetimini tek muhatap ve tek sözleşme yaklaşımıyla birleştirir.', highlights: ['Tek muhatap, tek sözleşme', 'Web ve medya dahil tam ekosistem', 'Kurumsal teknoloji yönetimi'], details: ['BT Paketi: Kurumsal E-posta, Hesap ve Cihaz Yönetimi', 'Sunucu Paketi: Sunucu, Ağ ve Yedekleme Yönetimi', 'Güvenlik Paketi: Siber Güvenlik, Çalışan Eğitimi ve Uyum Hazırlığı', 'Bakım Paketi: Teknik Destek, Bakım ve Onarım', 'Web Paketi: Web Sitesi Yönetimi ve Geliştirme', 'Medya Paketi: Sosyal Medya ve Görsel İçerik Yönetimi', 'Tüm teknoloji alanlarında tek koordinasyon noktası'], tone: 'purple' },
