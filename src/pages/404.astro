---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';

const pageTitle = "Sayfa Bulunamadı (404)";
const pageDescription = "Aradığınız sayfa taşınmış veya silinmiş olabilir.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32 text-center">
    <span class="text-6xl font-extrabold text-brandBlue-600 block mb-4">404</span>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-navy-900 tracking-tight mb-4">
      Aradığınız sayfa bulunamadı.
    </h1>
    <p class="text-base sm:text-lg text-slate-600 max-w-md mx-auto mb-8 leading-relaxed">
      Bağlantı değişmiş veya adres hatalı yazılmış olabilir. Ana sayfaya dönebilir ya da hizmetlerimizi inceleyebilirsiniz.
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button href="/" size="md" variant="primary">
        Ana Sayfaya Dön
      </Button>
      <Button href="/hizmetler" size="md" variant="outline">
        Hizmetleri İncele →
      </Button>
    </div>
  </div>
</BaseLayout>
