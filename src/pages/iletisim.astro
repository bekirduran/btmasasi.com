---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import { siteConfig } from '../config/site';

const pageTitle = "BT Masası ile İletişim";
const pageDescription = "İşletmenizin BT desteği, altyapı ve danışmanlık ihtiyaçları için bizimle iletişime geçin.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="bg-slate-50 border-b border-slate-200 py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <Breadcrumbs items={[{ label: "İletişim" }]} />
      <div class="mt-4">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-navy-900 tracking-tight leading-tight">
          {pageTitle}
        </h1>
        <p class="text-base sm:text-lg text-slate-600 mt-4 leading-relaxed max-w-2xl mx-auto font-normal">
          İşletmenizin kullanıcı, cihaz, ağ ve destek ihtiyacını kısaca paylaşın. Mevcut yapınızı anlamak ve uygun sonraki adımı belirlemek için sizinle iletişime geçelim.
        </p>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Sol: İletişim Kanalları & Bilgilendirme -->
      <div class="lg:col-span-5 space-y-6">
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 sm:p-8">
          <h2 class="text-lg font-bold text-navy-900 mb-4">
            İletişim Kanalları
          </h2>

          <div class="space-y-4 text-sm text-slate-600">
            {siteConfig.email && (
              <div>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Kurumsal E-posta</span>
                <a href={`mailto:${siteConfig.email}`} class="text-brandBlue-600 font-medium hover:underline text-base mt-0.5 inline-block">
                  {siteConfig.email}
                </a>
              </div>
            )}

            {siteConfig.phoneDisplay && (
              <div>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Telefon</span>
                <a href={`tel:${siteConfig.phoneE164}`} class="text-navy-900 font-semibold hover:text-brandBlue-600 text-base mt-0.5 inline-block">
                  {siteConfig.phoneDisplay}
                </a>
              </div>
            )}

            <div>
              <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Çalışma Saatleri</span>
              <p class="text-navy-900 font-medium mt-0.5">{siteConfig.businessHours}</p>
            </div>

            <div>
              <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Hizmet Bölgeleri</span>
              <p class="text-navy-900 font-medium mt-0.5">Yerinde: Aksaray Merkez & OSB</p>
              <p class="text-slate-500 text-xs">Uzaktan: Türkiye geneli</p>
            </div>

            {(siteConfig.socialLinks.linkedin || siteConfig.socialLinks.instagram) && (
              <div>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Sosyal Medya</span>
                <div class="flex items-center gap-3.5 mt-1.5 flex-wrap">
                  {siteConfig.socialLinks.linkedin && (
                    <a
                      href={siteConfig.socialLinks.linkedin}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-xs text-brandBlue-600 hover:text-brandBlue-800 font-medium transition-colors"
                      aria-label="BT Masası LinkedIn"
                    >
                      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                        <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.64a1.64 1.64 0 1 0 0 3.28 1.64 1.64 0 0 0 0-3.28Z"/>
                      </svg>
                      <span>LinkedIn</span>
                    </a>
                  )}
                  {siteConfig.socialLinks.instagram && (
                    <a
                      href={siteConfig.socialLinks.instagram}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-xs text-pink-600 hover:text-pink-700 font-medium transition-colors"
                      aria-label="BT Masası Instagram"
                    >
                      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069M12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
                      </svg>
                      <span>Instagram</span>
                    </a>
                  )}
                </div>
              </div>
            )}
          </div>
        </div>

        <!-- Alternatif CTA -->
        <div class="p-6 rounded-2xl bg-brandBlue-50 border border-brandBlue-200 text-brandBlue-950 text-xs sm:text-sm leading-relaxed">
          <h3 class="font-bold text-navy-900 mb-1">Daha Kapsamlı Değerlendirme İçin</h3>
          <p class="mb-3">
            Kullanıcı ve cihaz sayınızı belirterek teklif ve analiz almak isterseniz ön değerlendirme formunu kullanabilirsiniz.
          </p>
          <a
            href="/ucretsiz-bt-kontrolu"
            class="inline-block text-xs font-semibold px-3 py-2 bg-brandBlue-600 hover:bg-brandBlue-700 text-white rounded-lg transition-colors shadow-sm"
          >
            Ücretsiz BT Kontrol Formu →
          </a>
        </div>
      </div>

      <!-- Sağ: İletişim Formu -->
      <div class="lg:col-span-7 bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-sm">
        <h2 class="text-xl font-bold text-navy-900 mb-6">
          Bize Mesaj Gönderin
        </h2>
        <ContactForm />
      </div>

    </div>
  </div>
</BaseLayout>
