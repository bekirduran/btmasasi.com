---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import { siteConfig } from '../config/site';

const pageTitle = "BT Masası ile İletişim";
const pageDescription = "İşletmenizin BT desteği, altyapı ve danışmanlık ihtiyaçları için bizimle iletişime geçin.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="bg-slate-50 border-b border-slate-200 py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <Breadcrumbs items={[{ label: "İletişim" }]} />
      <div class="mt-4">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-navy-900 tracking-tight leading-tight">
          {pageTitle}
        </h1>
        <p class="text-base sm:text-lg text-slate-600 mt-4 leading-relaxed max-w-2xl mx-auto font-normal">
          İşletmenizin kullanıcı, cihaz, ağ ve destek ihtiyacını kısaca paylaşın. Mevcut yapınızı anlamak ve uygun sonraki adımı belirlemek için sizinle iletişime geçelim.
        </p>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Sol: İletişim Kanalları & Bilgilendirme -->
      <div class="lg:col-span-5 space-y-6">
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 sm:p-8">
          <h2 class="text-lg font-bold text-navy-900 mb-4">
            İletişim Kanalları
          </h2>

          <div class="space-y-4 text-sm text-slate-600">
            {siteConfig.email && (
              <div>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Kurumsal E-posta</span>
                <a href={`mailto:${siteConfig.email}`} class="text-brandBlue-600 font-medium hover:underline text-base mt-0.5 inline-block">
                  {siteConfig.email}
                </a>
              </div>
            )}

            {siteConfig.phoneDisplay && (
              <div>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Telefon</span>
                <a href={`tel:${siteConfig.phoneE164}`} class="text-navy-900 font-semibold hover:text-brandBlue-600 text-base mt-0.5 inline-block">
                  {siteConfig.phoneDisplay}
                </a>
              </div>
            )}

            <div>
              <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Çalışma Saatleri</span>
              <p class="text-navy-900 font-medium mt-0.5">{siteConfig.businessHours}</p>
            </div>

            <div>
              <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Hizmet Bölgeleri</span>
              <p class="text-navy-900 font-medium mt-0.5">Yerinde: Aksaray Merkez & OSB</p>
              <p class="text-slate-500 text-xs">Uzaktan: Türkiye geneli</p>
            </div>
          </div>
        </div>

        <!-- Alternatif CTA -->
        <div class="p-6 rounded-2xl bg-brandBlue-50 border border-brandBlue-200 text-brandBlue-950 text-xs sm:text-sm leading-relaxed">
          <h3 class="font-bold text-navy-900 mb-1">Daha Kapsamlı Değerlendirme İçin</h3>
          <p class="mb-3">
            Kullanıcı ve cihaz sayınızı belirterek teklif ve analiz almak isterseniz ön değerlendirme formunu kullanabilirsiniz.
          </p>
          <a
            href="/ucretsiz-bt-kontrolu"
            class="inline-block text-xs font-semibold px-3 py-2 bg-brandBlue-600 hover:bg-brandBlue-700 text-white rounded-lg transition-colors shadow-sm"
          >
            Ücretsiz BT Kontrol Formu →
          </a>
        </div>
      </div>

      <!-- Sağ: İletişim Formu -->
      <div class="lg:col-span-7 bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-sm">
        <h2 class="text-xl font-bold text-navy-900 mb-6">
          Bize Mesaj Gönderin
        </h2>
        <ContactForm />
      </div>

    </div>
  </div>
</BaseLayout>
