---
import ServiceContent from '../../components/marketing/ServiceContent.astro';
import { services } from '../../data/services';
import { provinces, serviceLocationPath } from '../../lib/locations';
const serviceDetail = services.find(s => s.slug === 'kvkk-teknik-uyum')!;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import Card from '../../components/ui/Card.astro';
import KvkkRiskForm from '../../components/forms/KvkkRiskForm.astro';
import { siteConfig } from '../../config/site';

const pageTitle = "KVKK Teknik Uyum ve Veri Güvenliği Hizmeti | BT Masası";
const pageDescription = "İşletmenizin kişisel veri işleyen BT sistemlerini analiz ediyor, erişim, yedekleme ve güvenlik kontrollerini yöneterek KVKK teknik uyumunu destekliyoruz.";
const canonicalUrl = `${siteConfig.domain}/hizmetler/kvkk-teknik-uyum`;

// 1. Service Schema
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'KVKK Teknik Uyum ve Veri Güvenliği',
  serviceType: 'Data Protection and Technical Compliance Solutions',
  provider: {
    '@type': 'Organization',
    name: 'BT Masası Bilgi Teknolojileri ve Danışmanlık',
    url: siteConfig.domain,
  },
  description: pageDescription,
  areaServed: [
    {
      '@type': 'AdministrativeArea',
      name: 'Aksaray',
    },
    {
      '@type': 'Country',
      name: 'Türkiye',
    },
  ],
  url: canonicalUrl,
};

// 2. BreadcrumbList Schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Ana Sayfa',
      item: siteConfig.domain,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Hizmetler',
      item: `${siteConfig.domain}/hizmetler`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'KVKK Teknik Uyum',
      item: canonicalUrl,
    },
  ],
};

// 3. FAQPage Schema (Sayfa içeriğiyle birebir uyumlu)
const faqList = [
  {
    q: "KVKK Guard nedir?",
    a: "KVKK Guard, işletmelerin kişisel veri içeren BT sistemlerini teknik açıdan analiz eden, erişim yetkilerini düzenleyen ve veri güvenliği süreçlerini periyodik olarak yöneten BT Masası hizmetidir."
  },
  {
    q: "VERBİS kaydını siz mi yapıyorsunuz?",
    a: "BT Masası teknik envanter, sistem haritalama ve veri güvenliği tarafında destek sağlar. VERBİS kayıt yükümlülüğüne ilişkin hukuki değerlendirme gerektiğinde uzman hukuk danışmanıyla çalışılması önerilir."
  },
  {
    q: "Küçük işletmelerin KVKK çalışması yapması gerekir mi?",
    a: "VERBİS kayıt yükümlülüğü ile KVKK kapsamındaki veri güvenliği yükümlülükleri aynı şey değildir. İşletmenin büyüklüğüne veya çalışan sayısına bakılmaksızın teknik veri güvenliği ve erişim kontrolleri gereklidir."
  },
  {
    q: "KVKK teknik risk analizi neleri kapsar?",
    a: "Bilgisayarlar, kullanıcı hesapları, erişim yetkileri, yedekleme, MFA, endpoint güvenliği, NAS/server erişimleri, cloud servisleri ve diğer kişisel veri içeren sistemler değerlendirilir."
  },
  {
    q: "Hizmet tek seferlik mi?",
    a: "İlk kurulum ve risk analizi sonrasında sürekli izleme ve yönetim hizmeti alınabilir. Yeni personel girişleri, ayrılışları ve yazılım değişiklikleri düzenli teknik takip gerektirir."
  },
  {
    q: "Hukuki danışmanlık veriyor musunuz?",
    a: "BT Masası'nın hizmeti teknik KVKK uyumu ve kişisel veri güvenliğine odaklanır. Aydınlatma metinleri, sözleşmeler ve hukuki işleme şartları gibi hukuki danışmanlık gereken konular bağımsız hukuk danışmanları tarafından yürütülmelidir."
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqList.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};

const combinedSchemas = [serviceSchema, breadcrumbSchema, faqSchema];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  customSchema={combinedSchemas}
>
  <!-- 1. BREADCRUMBS & HERO SECTION -->
  <section class="bg-gradient-to-b from-slate-50 to-white border-b border-slate-200 pt-8 pb-16 sm:pb-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb Navigasyonu -->
      <Breadcrumbs
        items={[
          { label: "Hizmetler", href: "/hizmetler" },
          { label: "KVKK Teknik Uyum" },
        ]}
      />

      <div class="max-w-4xl mt-8">
        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brandBlue-50 border border-brandBlue-200 text-brandBlue-800 text-xs font-bold uppercase tracking-wider mb-6">
          <svg class="w-3.5 h-3.5 text-brandBlue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>KVKK GUARD</span>
        </div>

        <!-- Tek ve Net H1 -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-navy-900 tracking-tight leading-[1.15]">
          KVKK Teknik Uyum ve Veri Güvenliği
        </h1>

        <!-- Ana Açıklama (AI ve Kullanıcı Odaklı) -->
        <p class="text-lg sm:text-xl text-slate-600 mt-6 leading-relaxed font-normal">
          Kişisel veriler yalnızca dosyalarda değil; bilgisayarlarda, sunucularda, bulut sistemlerinde, e-postalarda, kamera kayıtlarında ve kurumsal yazılımlarda bulunur. BT Masası, bu sistemleri teknik açıdan analiz ederek veri güvenliği risklerini görünür ve yönetilebilir hale getirir.
        </p>

        <!-- CTA Butonları -->
        <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a
            href="#on-analiz-formu"
            id="hero-primary-cta"
            class="inline-flex items-center justify-center px-6 py-3.5 text-base font-bold text-white bg-brandBlue-600 hover:bg-brandBlue-700 active:bg-brandBlue-800 rounded-xl shadow-sm transition-all focus-visible:outline-brandBlue-600"
          >
            Ücretsiz KVKK Teknik Risk Analizi →
          </a>
          <a
            href="#hizmet-kapsami"
            class="inline-flex items-center justify-center px-6 py-3.5 text-base font-semibold text-slate-700 hover:text-navy-900 bg-white hover:bg-slate-50 border border-slate-300 rounded-xl transition-colors"
          >
            Hizmet Kapsamını İncele
          </a>
        </div>

        <!-- Değer Vurgusu Rozetleri -->
        <div class="mt-12 pt-8 border-t border-slate-200 grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs sm:text-sm text-slate-600 font-medium">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-brandTeal-500"></span>
            <span>Veri Haritalama</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-brandTeal-500"></span>
            <span>Erişim & RBAC Kontrolü</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-brandTeal-500"></span>
            <span>Yedek & Log Doğrulama</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-brandTeal-500"></span>
            <span>Sürekli Teknik İzleme</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. PROBLEM BÖLÜMÜ -->
  <section class="py-16 sm:py-24 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-navy-900 tracking-tight">
          KVKK yalnızca evrak hazırlamak değildir
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
          Bir işletmenin kişisel veri güvenliği yalnızca aydınlatma metinleri veya VERBİS bildirimlerinden oluşmaz. Verinin hangi bilgisayarda bulunduğu, kimlerin erişebildiği, nasıl yedeklendiği, eski çalışanların hesaplarının kapatılıp kapatılmadığı ve bulut sistemlerinin nasıl korunduğu da sürecin önemli parçalarıdır.
        </p>
      </div>

      <!-- 6 Problem Kartı -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <Card>
          <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center font-bold mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-navy-900 mb-2">Kontrolsüz Erişim</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Eski çalışanlar veya yetkisiz kullanıcılar dosya sunucularına, ortak klasörlere veya muhasebe veritabanlarına hala erişebiliyor olabilir.
          </p>
        </Card>

        <Card>
          <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-navy-900 mb-2">Dağınık Veri</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Kişisel veriler personelin masaüstü bilgisayarlarında, e-postalarda, yerel NAS cihazlarında, bulut sürücülerinde ve USB belleklerde kontrolsüz biçimde dağılmıştır.
          </p>
        </Card>

        <Card>
          <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center font-bold mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-navy-900 mb-2">Yetersiz Yedekleme</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Kritik kişisel verilerin yedeği düzenli alınmıyor, şifrelenmemiş ortamda tutuluyor veya fidye yazılımı (ransomware) karşısında geri dönüp dönmeyeceği test edilmemiş olabilir.
          </p>
        </Card>

        <Card>
          <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-navy-900 mb-2">Zayıf Hesap Güvenliği</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Kurumsal e-posta ve bulut hesaplarında çok faktörlü doğrulama (MFA) açık değildir; basit veya ortak parolalar kullanılıyor olabilir.
          </p>
        </Card>

        <Card>
          <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center font-bold mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-navy-900 mb-2">Belirsiz Veri Saklama</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Hangi müşteri, personel veya aday verisinin ne kadar süre saklanacağı ve süresi dolduğunda teknik olarak nasıl güvenle silineceği belirsizdir.
          </p>
        </Card>

        <Card>
          <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center font-bold mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-navy-900 mb-2">Eksik Kayıt ve İzleme</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Kim, hangi sisteme, ne zaman erişti ve hangi dosyaları kopyaladı sorusunun cevabı güvenlik logları tutulmadığı için bilinemez.
          </p>
        </Card>
      </div>
    </div>
  </section>

  <!-- 3. “BİZ NE YAPIYORUZ?” (HİZMET KAPSAMI 10 MODÜL) -->
  <section id="hizmet-kapsami" class="py-16 sm:py-24 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-16">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-navy-900 tracking-tight">
          KVKK Guard kapsamında neleri yönetiyoruz?
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
          Kişisel verinin nerede tutulduğunu, kimin eriştiğini ve nasıl korunduğunu teknik kontrollerle görünür, ölçülebilir ve denetlenebilir hale getiriyoruz.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Modül 1 -->
        <div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-brandBlue-50 text-brandBlue-600 flex items-center justify-center font-bold mb-4">
              01
            </div>
            <h3 class="text-xl font-bold text-navy-900 mb-2">Kişisel Veri Sistem Haritası</h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-4">
              İşletmedeki kişisel verilerin bulunabileceği tüm teknik ortamları tespit ediyoruz: Bilgisayarlar, sunucular, NAS, kurumsal e-posta, Microsoft 365, Google Workspace, CRM, ERP, muhasebe yazılımları, kamera sistemleri, bulut depolama ve mobil cihazlar.
            </p>
          </div>
          <div class="pt-3 border-t border-slate-100 text-xs text-brandBlue-700 font-semibold">
            “Kişisel verinin nerede tutulduğunu anlamadan veri güvenliği sağlanamaz.”
          </div>
        </div>

        <!-- Modül 2 -->
        <div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-brandBlue-50 text-brandBlue-600 flex items-center justify-center font-bold mb-4">
              02
            </div>
            <h3 class="text-xl font-bold text-navy-900 mb-2">BT Varlık Envanteri</h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-4">
              Kişisel veri işleyen veya bu verilere köprü oluşturan tüm donanım ve yazılım varlıklarını kayıt altına alıyoruz: PC, laptop, sunucu, firewall, NAS, şirket telefonları, tabletler, kamera kayıt cihazları, ağ anahtarları ve SaaS servisleri.
            </p>
          </div>
          <div class="pt-3 border-t border-slate-100 text-xs text-slate-500 font-medium">
            Donanım, işletim sistemi, lisans ve zimmet eşleştirmesi.
          </div>
        </div>

        <!-- Modül 3 -->
        <div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-brandBlue-50 text-brandBlue-600 flex items-center justify-center font-bold mb-4">
              03
            </div>
            <h3 class="text-xl font-bold text-navy-900 mb-2">Veri Erişim ve Yetki Analizi (RBAC)</h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-4">
              Hangi kullanıcı, hangi sisteme, hangi seviyede ve hangi iş amacıyla erişiyor? Rol tabanlı erişim kontrolü (Role-Based Access Control) yaklaşımıyla İK, Muhasebe, Satış ve Yönetim klasörlerindeki gereksiz yetkileri tespit edip sınırlandırıyoruz.
            </p>
          </div>
          <div class="pt-3 border-t border-slate-100 text-xs text-slate-500 font-medium">
            Örnek: İK → Personel Özlük | Muhasebe → Finans | Satış → CRM.
          </div>
        </div>

        <!-- Modül 4 -->
        <div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-brandBlue-50 text-brandBlue-600 flex items-center justify-center font-bold mb-4">
              04
            </div>
            <h3 class="text-xl font-bold text-navy-900 mb-2">Kullanıcı Yaşam Döngüsü Yönetimi</h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-4">
              Çalışan işe başladığında, departman değiştirdiğinde ve özellikle **işten ayrıldığında** hesap ve erişim haklarının eksiksiz yönetilmesi. Eski çalışanların e-posta ve dosya erişimlerinin açık kalması riskini tamamen ortadan kaldırıyoruz.
            </p>
          </div>
          <div class="pt-3 border-t border-slate-100 text-xs text-rose-700 font-semibold">
            Kritik Güvenlik: İşten ayrılan personelin erişimlerinin derhal kapatılması.
          </div>
        </div>

        <!-- Modül 5 -->
        <div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-brandBlue-50 text-brandBlue-600 flex items-center justify-center font-bold mb-4">
              05
            </div>
            <h3 class="text-xl font-bold text-navy-900 mb-2">Uç Nokta Güvenliği (Endpoint Security)</h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-4">
              Kişisel veri barındıran veya erişen istemci bilgisayarlarda: İşletim sistemi güncellemeleri, merkezi antivirüs/EDR durumu, disk şifreleme (BitLocker), yerel yönetici (local admin) yetkilerinin kısıtlanması, parola politikaları, ekran kilit süreleri ve USB kısıtlamaları.
            </p>
          </div>
          <div class="pt-3 border-t border-slate-100 text-xs text-slate-500 font-medium">
            Dizüstü bilgisayar çalınsa dahi şifrelenmiş disk sayesinde veri korunur.
          </div>
        </div>

        <!-- Modül 6 -->
        <div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-brandBlue-50 text-brandBlue-600 flex items-center justify-center font-bold mb-4">
              06
            </div>
            <h3 class="text-xl font-bold text-navy-900 mb-2">MFA ve Kimlik Güvenliği</h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-4">
              Kişisel veri sızıntılarının en yaygın kaynağı ele geçirilen e-posta şifreleridir. Microsoft 365, Google Workspace, kurumsal VPN, bulut portalları ve yönetici hesaplarında çok faktörlü doğrulamayı (MFA) zorunlu hale getiriyoruz.
            </p>
          </div>
          <div class="pt-3 border-t border-slate-100 text-xs text-slate-500 font-medium">
            Şifre ele geçirilse bile onay kodu olmadan hesap açılamaz.
          </div>
        </div>

        <!-- Modül 7 -->
        <div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-brandBlue-50 text-brandBlue-600 flex items-center justify-center font-bold mb-4">
              07
            </div>
            <h3 class="text-xl font-bold text-navy-900 mb-2">Yedekleme ve Felaket Kurtarma</h3>
            <p class="text-sm text-slate-600 leading-relaxed mb-4">
