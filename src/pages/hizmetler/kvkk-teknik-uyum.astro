  <!-- Analytics Event Listener Script -->
  <script>
    function trackEvent(eventName: string, params: Record<string, any> = {}) {
      try {
        const dataLayer = (window as any).dataLayer;
        if (Array.isArray(dataLayer)) {
          dataLayer.push({ event: eventName, ...params });
        }
        window.dispatchEvent(new CustomEvent(eventName, { detail: params }));
      } catch {
        // sessizce geç
      }
    }

    // Sayfa görüntüleme
    trackEvent('kvkk_page_view', { page: window.location.pathname });

    // Hero CTA tıklaması
    const heroBtn = document.getElementById('hero-primary-cta');
    if (heroBtn) {
      heroBtn.addEventListener('click', () => {
        trackEvent('kvkk_risk_analysis_click');
      });
    }

    // Telefon tıklaması
    const phoneBtn = document.getElementById('kvkk-phone-cta');
    if (phoneBtn) {
      phoneBtn.addEventListener('click', () => {
        trackEvent('kvkk_phone_click');
      });
    }

    // Yönetilen BT çapraz satış tıklaması
    const managedItBtn = document.getElementById('managed-it-cross-link');
    if (managedItBtn) {
      managedItBtn.addEventListener('click', () => {
        trackEvent('kvkk_managed_it_click');
      });
    }
  </script>
