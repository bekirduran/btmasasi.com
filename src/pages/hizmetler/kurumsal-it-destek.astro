---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';

const pageTitle = "Kurumsal IT Destek";
const pageDescription = "Çalışanların bilgisayar, e-posta, yazıcı, bağlantı ve uygulama sorunlarını kayıt altına alınan, önceliklendirilen bir destek süreciyle yönetin.";

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: pageTitle,
  serviceType: 'IT Support Services',
  provider: {
    '@type': 'Organization',
    name: 'BT Masası',
    url: 'https://btmasasi.com',
  },
  description: pageDescription,
  areaServed: ['Aksaray', 'Türkiye'],
};
---

<BaseLayout title={pageTitle} description={pageDescription} customSchema={serviceSchema}>
  <div class="bg-slate-50 border-b border-slate-200 py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs
        items={[
          { label: "Hizmetler", href: "/hizmetler" },
          { label: pageTitle },
        ]}
      />
      <div class="mt-4">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-navy-900 tracking-tight">
          {pageTitle}
        </h1>
        <p class="text-lg sm:text-xl text-slate-600 mt-4 leading-relaxed font-normal">
          {pageDescription}
        </p>
      </div>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">
    
    <!-- Kapsam Bölümü -->
    <section>
      <h2 class="text-2xl sm:text-3xl font-bold text-navy-900 mb-6">
        Kullanıcı Destek Kapsamımız
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl border border-slate-200 bg-white">
          <h3 class="font-semibold text-navy-900 text-sm">Windows & Masaüstü Çözümleri</h3>
          <p class="text-xs text-slate-600 mt-1">İşletim sistemi kararlılığı, ofis yazılımları ve temel masaüstü araçlarının desteği.</p>
        </div>
        <div class="p-4 rounded-xl border border-slate-200 bg-white">
          <h3 class="font-semibold text-navy-900 text-sm">E-posta & Kullanıcı Hesapları</h3>
          <p class="text-xs text-slate-600 mt-1">Outlook, bulut e-posta yapılandırmaları ve şifre sıfırlama talepleri.</p>
        </div>
        <div class="p-4 rounded-xl border border-slate-200 bg-white">
          <h3 class="font-semibold text-navy-900 text-sm">Yazıcı & Ağ Bağlantısı Desteği</h3>
          <p class="text-xs text-slate-600 mt-1">Ağ yazıcıları, tarayıcılar, yerel Wi-Fi ve ortak dosya paylaşım sorunları.</p>
        </div>
        <div class="p-4 rounded-xl border border-slate-200 bg-white">
          <h3 class="font-semibold text-navy-900 text-sm">Uzaktan & Yerinde Müdahale</h3>
          <p class="text-xs text-slate-600 mt-1">Güvenli uzak bağlantıyla dakikalar içinde tespit; sözleşme kapsamına göre yerinde ziyaret.</p>
        </div>
        <div class="p-4 rounded-xl border border-slate-200 bg-white">
          <h3 class="font-semibold text-navy-900 text-sm">Yeni Cihaz & Kullanıcı Hazırlığı</h3>
          <p class="text-xs text-slate-600 mt-1">İşe başlayan yeni personel için standart güvenlik politikalarına uygun kurulum.</p>
        </div>
        <div class="p-4 rounded-xl border border-slate-200 bg-white">
          <h3 class="font-semibold text-navy-900 text-sm">Tedarikçi Koordinasyonu</h3>
          <p class="text-xs text-slate-600 mt-1">İnternet sağlayıcısı, fotokopi ve muhasebe yazılımı ekipleriyle teknik iletişim.</p>
        </div>
      </div>
    </section>

    <!-- Önceliklendirme Modeli -->
    <section>
      <h2 class="text-2xl sm:text-3xl font-bold text-navy-900 mb-4">
        Destek Taleplerinde Önceliklendirme Modeli
      </h2>
      <p class="text-base text-slate-600 leading-relaxed mb-6">
        Her talep aynı aciliyette değildir. İşletmenin tamamını etkileyen kesintiler, tek kullanıcıyı etkileyen sorunlardan önce ele alınır. İlk yanıt, çalışmaya başlama ve çözüm süreleri birbirinden farklı kavramlardır; uygulanacak hedefler sözleşmede açıkça belirtilir.
      </p>

      <div class="space-y-3">
        <div class="p-4 rounded-xl border border-rose-200 bg-rose-50/40 flex items-start gap-3">
          <span class="px-2 py-0.5 rounded font-bold text-xs bg-rose-600 text-white mt-0.5">P1 Kritik</span>
          <div>
            <h3 class="text-sm font-bold text-navy-900">İşletmenin veya Kritik Sürecin Durması</h3>
            <p class="text-xs text-slate-600 mt-0.5">Sunucu çökmesi, internetin tamamen kesilmesi veya tüm muhasebe operasyonunun durması.</p>
          </div>
        </div>

        <div class="p-4 rounded-xl border border-amber-200 bg-amber-50/40 flex items-start gap-3">
          <span class="px-2 py-0.5 rounded font-bold text-xs bg-amber-600 text-white mt-0.5">P2 Yüksek</span>
          <div>
            <h3 class="text-sm font-bold text-navy-900">Birden Fazla Kullanıcının Etkilenmesi</h3>
            <p class="text-xs text-slate-600 mt-0.5">Bölgesel Wi-Fi kopması, ortak ağ klasörüne erişilememesi veya ana yazıcının devre dışı kalması.</p>
          </div>
        </div>

        <div class="p-4 rounded-xl border border-slate-200 bg-white flex items-start gap-3">
          <span class="px-2 py-0.5 rounded font-bold text-xs bg-brandBlue-600 text-white mt-0.5">P3 Normal</span>
          <div>
            <h3 class="text-sm font-bold text-navy-900">Tek Kullanıcılı Günlük Destek Talebi</h3>
            <p class="text-xs text-slate-600 mt-0.5">Bir çalışanın e-postasının takılması, monitör ayarı veya uygulama güncellemesi.</p>
          </div>
        </div>

        <div class="p-4 rounded-xl border border-slate-200 bg-white flex items-start gap-3">
          <span class="px-2 py-0.5 rounded font-bold text-xs bg-slate-600 text-white mt-0.5">P4 Planlı</span>
          <div>
            <h3 class="text-sm font-bold text-navy-900">Kurulum ve İyileştirme Talebi</h3>
            <p class="text-xs text-slate-600 mt-0.5">Yeni bilgisayar kurulumu, yazılım sürüm yükseltmesi veya donanım yer değişimi.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Alt CTA -->
    <div class="text-center pt-8 border-t border-slate-200">
      <h2 class="text-2xl font-bold text-navy-900 mb-3">
        Çalışanlarınızın Teknik Sorunlarını Kontrol Altına Alın
      </h2>
      <p class="text-slate-600 text-sm mb-6 max-w-xl mx-auto">
        Kullanıcı sayınızı ve çalışma düzeninizi paylaşın; ekibiniz için öngörülebilir bir kurumsal IT destek planı oluşturalım.
      </p>
      <Button href="/ucretsiz-bt-kontrolu" size="lg" variant="primary">
        Kurumsal IT Destek Teklifi Alın
      </Button>
    </div>

  </div>
</BaseLayout>
