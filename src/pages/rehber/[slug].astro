---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import Badge from '../../components/ui/Badge.astro';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: post.data.author,
    jobTitle: siteConfig.founderTitle,
  },
  publisher: {
    '@type': 'Organization',
    name: siteConfig.brandName,
    logo: {
      '@type': 'ImageObject',
      url: `${siteConfig.domain}/brand/logo.png`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `${siteConfig.domain}/rehber/${post.slug}`,
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={(post.data.updatedDate || post.data.pubDate).toISOString()}
  customSchema={articleSchema}
>
  <div class="bg-slate-50 border-b border-slate-200 py-10 sm:py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs
        items={[
          { label: "Rehber", href: "/rehber" },
          { label: post.data.title },
        ]}
      />
      <div class="mt-4">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <Badge variant="blue">{post.data.readTime} okuma</Badge>
          {post.data.tags.map((tag) => (
            <Badge variant="slate">{tag}</Badge>
          ))}
          <time
            datetime={post.data.pubDate.toISOString()}
            class="text-xs text-slate-500"
          >
            Yayın: {post.data.pubDate.toLocaleDateString('tr-TR', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-navy-900 tracking-tight leading-tight">
          {post.data.title}
        </h1>

        <p class="text-lg sm:text-xl text-slate-600 mt-4 leading-relaxed font-normal">
          {post.data.description}
        </p>

        <div class="flex items-center gap-3 mt-6 pt-6 border-t border-slate-200">
          <img
            src="/brand/bekir-duran.jpg"
            alt={post.data.author}
            class="w-11 h-11 rounded-full object-cover object-top shadow-sm border border-slate-200 flex-shrink-0"
            width="44"
            height="44"
            loading="lazy"
          />
          <div>
            <span class="font-semibold text-navy-900 block leading-tight">{post.data.author}</span>
            <span class="text-xs text-slate-500">{siteConfig.founderTitle}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="prose prose-slate prose-lg max-w-none prose-headings:text-navy-900 prose-headings:font-bold prose-a:text-brandBlue-600 hover:prose-a:underline prose-table:border prose-table:border-slate-200 prose-th:bg-slate-50 prose-th:p-3 prose-td:p-3 prose-td:border prose-td:border-slate-200">
      <Content />
    </div>

    <!-- İlgili Hizmet & Ön Değerlendirme Kutusu -->
    <div class="mt-16 bg-slate-50 border border-slate-200 rounded-2xl p-8 sm:p-10 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h2 class="text-xl font-bold text-navy-900 mb-2">
          İşletmeniz İçin Çözüm Üretelim
        </h2>
        <p class="text-sm text-slate-600 max-w-xl">
          Bu konuda yaşadığınız operasyonel zorlukları paylaşın, işletmenizin kullanıcı ve altyapı yapısına en uygun hizmet modelini birlikte belirleyelim.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 flex-shrink-0 w-full sm:w-auto">
        {post.data.relatedService && (
          <a
            href={post.data.relatedService}
            class="px-5 py-3 text-sm font-semibold text-slate-700 bg-white border border-slate-300 hover:bg-slate-100 rounded-xl text-center"
          >
            İlgili Hizmeti Gör
          </a>
        )}
        <a
          href="/ucretsiz-bt-kontrolu"
          class="px-5 py-3 text-sm font-semibold text-white bg-brandBlue-600 hover:bg-brandBlue-700 rounded-xl text-center shadow"
        >
          Ön Değerlendirme İste
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
