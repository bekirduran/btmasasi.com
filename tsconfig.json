{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["@cloudflare/workers-types", "vite/client"]
  },
  "include": [".astro/**/*", "src/**/*", "worker/**/*", "scripts/**/*", "tests/**/*", "astro.config.mjs"]
}
