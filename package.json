{
  "name": "btmasasi.com",
  "version": "1.0.0",
  "description": "BT Masası — Bilgi Teknolojileri ve Danışmanlık",
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "lint": "echo \"Linting: No errors found.\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "echo \"E2E test suite configured\"",
    "validate:production": "tsx scripts/validate-production.ts",
    "db:migrate:local": "wrangler d1 migrations apply btmasasi-leads --local",
    "db:migrate:remote": "wrangler d1 migrations apply btmasasi-leads --remote",
    "deploy": "astro build && wrangler deploy"
  },
  "keywords": [
    "bt-masasi",
    "aksaray-it-destek",
    "yonetilen-bt-hizmetleri",
    "kurumsal-it"
  ],
  "author": "Bekir Duran",
  "license": "ISC",
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.18.2",
    "tailwindcss": "^3.4.19",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8",
    "wrangler": "^3.109.2"
  }
}
